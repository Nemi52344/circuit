# Dependencies and build output
node_modules
.next

# The database itself. It holds the Supabase service key, the Meta app secret and
# token, the Higgsfield keys and the Zapier hook URL — none of which belong in a
# repository, public or private.
data/circuit.db*

# The accounts database, which arrived when brands were split out. It holds every password
# hash and every live session token — the one file in here that is worth more than the rest
# put together. It was not covered by the line above, because that line names circuit.db.
data/accounts.db*

# Backups are copies of that same database, with the same secrets inside them.
data/backups/

# Everything the company's own material lives in: product photography, generated
# drafts, scraped references, the morning briefings, and the receipts and card
# statements. Business documents, not source code.
data/uploads/*
!data/uploads/.gitkeep
data/receipts/
data/inbox/
data/product/
data/sources/*
!data/sources/README.txt

# Credentials of any kind
.env*
*.pem

# Build artefacts
tsconfig.tsbuildinfo

# BNC's full product requirements — strategy, competitor thinking, the lot.
# Kept out of a public repo; the app reads the local copy, which stays on this Mac.
docs/PRD.html
public/PRD.html

# The video toolchain pulls its own node_modules and renders large frames; the composition
# source and the finished files are what matter, not the machinery around them.
campaign/reel/node_modules/
campaign/reel/.hyperframes/
campaign/reel/renders/frames/

# A live password-recovery code. Short-lived, deleted on use, and never committed.
data/recovery-code.txt

# speech model for video captions — large, local only
data/models/
